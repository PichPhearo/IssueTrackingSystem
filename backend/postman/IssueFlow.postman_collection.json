{
	"info": {
		"_postman_id": "issueflow-auth-role-collection",
		"name": "IssueFlow API",
		"description": "Postman Collection for testing IssueFlow Auth, Role-Based Authorization, Projects, Issues, and Comments",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login as Admin",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/login", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "login"] }
					}
				},
				{
					"name": "Login as Project Manager",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"pm@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/login", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "login"] }
					}
				},
				{
					"name": "Login as Developer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"developer@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/login", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "login"] }
					}
				},
				{
					"name": "Login as QA",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"qa@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/login", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "login"] }
					}
				},
				{
					"name": "Get Me",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "http://127.0.0.1:8000/api/me", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "me"] }
					}
				}
			]
		},
		{
			"name": "User Management (Admin Only)",
			"item": [
				{
					"name": "List Users (Admin Only -> 403 for Dev)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "http://127.0.0.1:8000/api/users", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "users"] }
					}
				},
				{
					"name": "Update User Role (Admin Only)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"project_manager\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/users/3/role", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "users", "3", "role"] }
					}
				}
			]
		},
		{
			"name": "Projects",
			"item": [
				{
					"name": "Get Projects",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "http://127.0.0.1:8000/api/projects", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "projects"] }
					}
				},
				{
					"name": "Create Project (Admin/PM Only -> 403 for Dev)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Inventory Management System\",\n  \"description\": \"Internal store inventory application\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/projects", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "projects"] }
					}
				}
			]
		},
		{
			"name": "Issues & Comments",
			"item": [
				{
					"name": "List Issues",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "http://127.0.0.1:8000/api/issues", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "issues"] }
					}
				},
				{
					"name": "Update Issue Status (Dev / QA / PM)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"in_progress\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/issues/1/status", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "issues", "1", "status"] }
					}
				},
				{
					"name": "Add Comment to Issue",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"body\": \"Fixed the validation issue in the authentication service.\"\n}"
						},
						"url": { "raw": "http://127.0.0.1:8000/api/issues/1/comments", "protocol": "http", "host": ["127", "0", "0", "1"], "port": "8000", "path": ["api", "issues", "1", "comments"] }
					}
				}
			]
		}
	]
}
